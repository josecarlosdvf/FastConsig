# Environment
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastconsig
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fastconsig

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=7d
# Redis (required for durable event bus and operational metrics stack)
REDIS_URL=redis://localhost:6379
# Metrics scrape token for /metrics endpoint (set in production)
METRICS_TOKEN=GENERATE_SECURE_RANDOM_TOKEN_HERE_32_CHARS_MIN
# Grafana admin credentials (required in production)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin
OPS_FAILED_EVENTS_WARNING_THRESHOLD=10
LOG_LEVEL=info

# API
API_PORT=3001
API_URL=http://localhost:3001

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
