// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users         User[]
  refreshTokens RefreshToken[]
  configValues  ConfigValue[]
  configValueVersions ConfigValueVersion[]
  auditTrails AuditTrail[]

  @@map("tenants")
}

model ConfigValue {
  id         String   @id @default(uuid())
  tenant_id  String
  key        String
  scope      ConfigScope
  value      Json
  updated_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@unique([key, scope, tenant_id])
  @@index([scope, tenant_id])
  @@map("config_values")
}

model ConfigValueVersion {
  id          String   @id @default(uuid())
  tenant_id   String
  key         String
  scope       ConfigScope
  version     Int
  value       Json
  changed_by  String?
  changed_at  DateTime @default(now())
  rolled_back Boolean  @default(false)

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, key, scope, version])
  @@index([tenant_id, key, scope, changed_at])
  @@map("config_value_versions")
}

model AuditTrail {
  id           String   @id @default(uuid())
  tenant_id    String
  event_name   String
  actor_user_id String?
  trace_id     String?
  request_id   String?
  payload      Json
  created_at   DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, event_name, created_at])
  @@index([tenant_id, created_at])
  @@map("audit_trails")
}

model EventOutbox {
  id            String   @id @default(uuid())
  tenant_id     String?
  event_name    String
  payload       Json
  status        EventStatus @default(PENDING)
  attempts      Int      @default(0)
  max_attempts  Int      @default(5)
  last_error    String?
  next_retry_at DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([status, next_retry_at])
  @@index([tenant_id, event_name, created_at])
  @@map("event_outbox")
}

model User {
  id           String   @id @default(uuid())
  tenant_id    String
  name         String
  email        String
  password     String
  role         UserRole @default(MEMBER)
  is_active    Boolean  @default(true)
  updated_by   String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenant_id], references: [id])
  refreshTokens RefreshToken[]

  @@unique([email, tenant_id])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid())
  tenant_id    String
  user_id      String
  token_hash   String    @unique
  expires_at   DateTime
  revoked_at   DateTime?
  device_info  String?
  ip_address   String?
  last_used_at DateTime?
  created_at   DateTime  @default(now())

  user   User   @relation(fields: [user_id], references: [id])
  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([token_hash])
  @@index([user_id, tenant_id])
  @@map("refresh_tokens")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum ConfigScope {
  system
  tenant
}

enum EventStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  DEAD_LETTER
}
